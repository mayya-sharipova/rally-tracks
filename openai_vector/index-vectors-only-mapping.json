{
  "settings": {
    "index": {
      "number_of_shards": {{number_of_shards | default(1)}},
      "number_of_replicas": 0,
      "merge": {
        "policy": {
          "max_merged_segment": "25gb",
          "floor_segment": "1gb",
          "segments_per_tier": 5
        }
      }
    }
  },
  "mappings": {
    "dynamic": false,
    "_source": {
      "enabled": false
    },
    "properties": {
      "emb": {
        "type": "dense_vector",
        "element_type": "float",
        "dims": 1536,
        "index": true,
        "similarity": "dot_product",
        "index_options": {
          "type": {{ vector_index_type | default("int8_hnsw") | tojson }}
        }
      }
    }
  }
}
