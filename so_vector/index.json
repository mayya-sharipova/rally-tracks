{
  "settings": {
    "index": {
      "number_of_shards": {{number_of_shards | default(2)}},
      "number_of_replicas": 0,
      "merge": {
        "policy": {
          "max_merged_segment": "25gb",
          "floor_segment": "1gb",
          "segments_per_tier": 5
        }
      }
    }
  },
  "mappings": {
    "_source": {
      "excludes": ["titleVector"]
    },
    "properties": {
      "userId": {
        "type": "keyword"
      },
      "tags": {
        "type": "keyword"
      },
      "questionId": {
        "type": "keyword"
      },
      "creationDate": {
        "type": "date"
      },
      "title": {
        "type": "text"
      },
      "titleVector": {
        "type": "dense_vector",
        "dims" : 768,
        "index" : true,
        "similarity": "dot_product",
        "index_options": {
          "type": {{ vector_index_type | default("int8_hnsw") | tojson }}
        }
      },
      "acceptedAnswerId": {
        "type": "keyword"
      },
      "body": {
        "type": "text"
      }
    }
  }
}
