{
  "settings": {
    "index": {
      "number_of_shards": 2,
      "number_of_replicas": 0
      {% if aggressive_merge_policy %},
      "merge": {
        "policy": {
          "max_merged_segment": "25gb",
          "floor_segment": "1gb",
          "segments_per_tier": 5
        }
      }
      {% endif %}
    }
  },
  "mappings": {
    "dynamic": "strict",
    "_source": {
      "enabled": false
    },
    "properties": {
      "vector": {
        "type": "dense_vector",
        "dims" : 96,
        "index" : true,
        "similarity": "dot_product",
        "index_options": {
          "type": {{ vector_index_type | default("int8_hnsw") | tojson }},
          "m": 32,
          "ef_construction": 100
        }
      }
    }
  }
}
